# IOlabs AI SDR Platform — Environment Variables
# Copy to .env and fill in all values before running.
# NEVER commit .env to version control.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=iolabs
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=iolabs_sdr
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full async DSN used by SQLAlchemy
DATABASE_URL=postgresql+asyncpg://iolabs:changeme_strong_password@postgres:5432/iolabs_sdr

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
# Full DSN used by Celery and rate limiter
REDIS_URL=redis://:changeme_redis_password@redis:6379/0

# ── Celery ─────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:changeme_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:changeme_redis_password@redis:6379/1

# Per-stage queue lists — comma-separated list of {client_id}_{stage} queue names.
# provision_client.py appends a new client's queues when onboarding.
# Workers read these at startup to know which queues to consume.
# Example with two clients "acme" and "beta":
# CELERY_QUEUES_DISCOVERY=acme_discovery,beta_discovery
CELERY_QUEUES_DISCOVERY=
CELERY_QUEUES_CLASSIFY=
CELERY_QUEUES_ENRICH=
CELERY_QUEUES_EMAIL=
CELERY_QUEUES_REPLY=
CELERY_QUEUES_LINKEDIN=

# ── LLM / AI ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model to use for all LLM calls (Section 2)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VISION_MODEL=claude-sonnet-4-20250514

# ── External APIs ──────────────────────────────────────────────────────────
SERPAPI_API_KEY=your_serpapi_key_here
# Proprietary screenshot service base URL (internal)
SCREENSHOTTER_URL=http://screenshotter:8001

# ── API Server ─────────────────────────────────────────────────────────────
API_PORT=8000
# Secret key for internal API authentication
API_SECRET_KEY=changeme_secret_key_min_32_chars

# ── Platform ───────────────────────────────────────────────────────────────
# Base URL where webhook endpoints are reachable from the internet
PLATFORM_BASE_URL=https://your-server.example.com
# Platform operator alert email
OPERATOR_EMAIL=ops@iolabs.com

# ── Per-Client SMTP Credentials ────────────────────────────────────────────
# SMTP passwords are NOT stored in the client config JSON.
# They are injected at runtime from env vars using the pattern:
#   SMTP_PASSWORD_{CLIENT_ID_UPPER}
# Example for client_id="acme":
# SMTP_PASSWORD_ACME=smtp_password_here

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "true" to write structured JSON logs
LOG_JSON=false
